---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog" description="Artículos y reflexiones sobre desarrollo web, tecnología y más.">
  <section class="section">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">Blog</h1>

        <div class="p-12 bg-[rgb(var(--color-surface))] rounded-xl border border-[rgb(var(--color-border))]">
          <p class="text-xl text-[rgb(var(--color-text-muted))] mb-4">
            Próximamente
          </p>
          <p class="text-[rgb(var(--color-text-muted))]">
            Estoy preparando contenido interesante sobre desarrollo web, accesibilidad y tecnología. ¡Vuelve pronto!
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
