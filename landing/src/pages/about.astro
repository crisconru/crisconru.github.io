---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre mí" description="Conoce más sobre Cristóbal Contreras Rubio, su experiencia y trayectoria profesional.">
  <section class="section">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold mb-8">Sobre mí</h1>

        <div class="prose prose-lg dark:prose-invert max-w-none">
          <p class="text-lg text-[rgb(var(--color-text-muted))] mb-8">
            Soy Cristóbal Contreras Rubio, desarrollador frontend con pasión por crear experiencias web accesibles y de alto rendimiento.
          </p>

          <h2 class="text-2xl font-bold mt-12 mb-6">Experiencia</h2>
          <div class="space-y-6">
            <div class="p-6 bg-[rgb(var(--color-surface))] rounded-xl border border-[rgb(var(--color-border))]">
              <h3 class="font-semibold text-lg">Frontend Developer</h3>
              <p class="text-sm text-[rgb(var(--color-text-muted))] mt-1">Empresa XYZ &bull; 2020 - Presente</p>
              <p class="mt-3 text-[rgb(var(--color-text-muted))]">
                Desarrollo de aplicaciones web con React, TypeScript y arquitecturas modernas.
              </p>
            </div>
          </div>

          <h2 class="text-2xl font-bold mt-12 mb-6">Formación</h2>
          <div class="space-y-4">
            <div class="p-6 bg-[rgb(var(--color-surface))] rounded-xl border border-[rgb(var(--color-border))]">
              <h3 class="font-semibold">Ingeniería Informática</h3>
              <p class="text-sm text-[rgb(var(--color-text-muted))] mt-1">Universidad XYZ</p>
            </div>
          </div>

          <h2 class="text-2xl font-bold mt-12 mb-6">Charlas y eventos</h2>
          <div class="space-y-4">
            <div class="p-6 bg-[rgb(var(--color-surface))] rounded-xl border border-[rgb(var(--color-border))]">
              <h3 class="font-semibold">Accesibilidad web en 2024</h3>
              <p class="text-sm text-[rgb(var(--color-text-muted))] mt-1">Conferencia Tech &bull; 2024</p>
            </div>
          </div>

          <h2 class="text-2xl font-bold mt-12 mb-6">Cursos impartidos</h2>
          <div class="space-y-4">
            <div class="p-6 bg-[rgb(var(--color-surface))] rounded-xl border border-[rgb(var(--color-border))]">
              <h3 class="font-semibold">Introducción a TypeScript</h3>
              <p class="text-sm text-[rgb(var(--color-text-muted))] mt-1">Plataforma de formación</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
