---
import { Icon } from 'astro-icon/components';

const socialLinks = [
  { href: 'https://github.com/crisconru', label: 'GitHub', icon: 'lucide:github' },
  { href: 'https://linkedin.com/in/crisconru', label: 'LinkedIn', icon: 'lucide:linkedin' },
  { href: 'https://twitter.com/crisconru', label: 'Twitter', icon: 'lucide:twitter' },
];

const currentYear = new Date().getFullYear();
---

<footer class="hidden md:block border-t border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))]">
  <div class="container py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[rgb(var(--color-text-muted))]">
        &copy; {currentYear} Cristóbal Contreras Rubio. Todos los derechos reservados.
      </p>

      <div class="flex items-center gap-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="p-2 rounded-lg text-[rgb(var(--color-text-muted))] hover:text-[rgb(var(--color-text))] hover:bg-[rgb(var(--color-bg))] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              <Icon name={link.icon} class="w-5 h-5" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
